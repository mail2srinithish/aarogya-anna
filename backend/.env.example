# ─────────────────────────────────────────────────────────────────────────────
#  AarogyaAnna — Backend Environment Variables
#  STEP: Copy this file → .env  then fill in your values.
#  ONLY GROQ_API_KEY is required. Everything else has a working default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database (SQLite — NO setup needed) ──────────────────────────────────────
# The database file is created automatically at data/aarogya_anna.db
# on first run. You do NOT need MySQL, PostgreSQL, or any external DB.
# Optionally override the path:
# DB_PATH=./data/aarogya_anna.db

# ── JWT Authentication ────────────────────────────────────────────────────────
# Change these to any long random strings (32+ chars recommended)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES=7d

# ── Groq AI  <-- REQUIRED FOR CHATBOT ────────────────────────────────────────
# Get a FREE key at: https://console.groq.com/keys  (takes 30 seconds)
# Model used: llama-3.3-70b-versatile  (free tier: 30 req/min, 14400 req/day)
GROQ_API_KEY=your_groq_api_key_here

# ── USDA FoodData Central — OPTIONAL ─────────────────────────────────────────
# Free key at: https://fdc.nal.usda.gov/api-guide.html
# Leave as DEMO_KEY for 30 req/hr (enough for development)
USDA_API_KEY=DEMO_KEY

# ── Google OAuth — OPTIONAL ───────────────────────────────────────────────────
# Only needed for Google Sign-In button. App works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Redis — OPTIONAL ──────────────────────────────────────────────────────────
# App runs fine without Redis; caching is skipped gracefully.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Email (password reset) — OPTIONAL ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=AarogyaAnna <noreply@aarogya-anna.com>

# ── ML Service — OPTIONAL ─────────────────────────────────────────────────────
# App has a rule-based fallback if this service is not running.
ML_SERVICE_URL=http://localhost:8000
